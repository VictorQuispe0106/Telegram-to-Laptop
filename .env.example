# Copiar a .env y completar los valores reales. NUNCA commitear el .env.

# Token del bot de Telegram (obligatorio)
TELEGRAM_BOT_TOKEN=

# IDs de Telegram con permiso, separados por coma (obligatorio)
ALLOWED_USER_IDS=

# Sesión del agente RPC del asistente
SESSION_ID=spidervic-telegram

# Timeout del agente en segundos
TIMEOUT_SECONDS=600

# Chat al que el watchdog registra el boton de la Mini App
# (si se deja vacio usa el primer ID de ALLOWED_USER_IDS)
MINIAPP_CHAT_ID=
